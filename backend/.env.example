# Environment variables for Travel Expense Tracker backend

# Port the Express server runs on
PORT=4000

# PostgreSQL connection string
# Example for local database:
# postgres://username:password@localhost:5432/travel
DATABASE_URL=postgres://<user>:<password>@<host>:5432/<database>

# SSL is on by default (needed for Neon), set to false for a plain local Postgres
DATABASE_SSL=true

# Secret key used for JWT authentication
JWT_SECRET=<your-jwt-secret>
